################################################################################
##                                                                            ##
##                     Configuration for the ZFS feature                      ##
##                                                                            ##
################################################################################

{ config, lib, ... }:

{
  config = lib.mkIf config.confkit.features.zfs.enable {

    ########################################################################
    ##                              Services                              ##
    ########################################################################

    services = {
      zfs = {
        autoScrub = {
          interval = "Mon 20:00";
          randomizedDelaySec = "0";
        };
      };
    };
  };
}
