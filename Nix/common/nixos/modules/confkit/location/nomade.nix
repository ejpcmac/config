################################################################################
##                                                                            ##
##                            Nomade configuration                            ##
##                                                                            ##
################################################################################

{ config, lib, ... }:

{
  config = lib.mkIf (config.confkit.info.location == "nomade") {

    ########################################################################
    ##                        Location & Time Zone                        ##
    ########################################################################

    location = {
      latitude = 49.18;
      longitude = -0.23;
    };

    time.timeZone = "Europe/Paris";
  };
}
