################################################################################
##                                                                            ##
##                    Configuration for the undocked setup                    ##
##                                                                            ##
################################################################################

{ config, lib, ... }:

{
  config = lib.mkIf (builtins.elem "undocked" config.confkit.profile.usage) {

    ########################################################################
    ##                              Services                              ##
    ########################################################################

    services = {
      xserver.dpi = 141;
    };

    ########################################################################
    ##                         Home configuration                         ##
    ########################################################################

    home-manager.users.jpc = {
      services = {
        polybar = {
          config = {
            "module/alsa".format-volume = "<label-volume>";
          };
        };
      };
    };
  };
}
