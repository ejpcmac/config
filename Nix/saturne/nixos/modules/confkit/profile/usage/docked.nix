################################################################################
##                                                                            ##
##                     Configuration for the docked setup                     ##
##                                                                            ##
################################################################################

{ config, lib, ... }:

{
  config = lib.mkIf (builtins.elem "docked" config.confkit.profile.usage) {

    ########################################################################
    ##                              Services                              ##
    ########################################################################

    services = {
      xserver.dpi = 212;
    };
  };
}
