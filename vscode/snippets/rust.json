    "fn test()": {
        "prefix": "test",
        // prettier-ignore
        "body": [
            "#[test]",
            "fn $0() {",
            "    todo!()",
            "}"
        ],
        "description": "Write a new test"
    },
    "fn test() -> Result<()>": {
        "prefix": "rtest",
        // prettier-ignore
        "body": [
            "#[test]",
